{
  "name": "herramienta-emprendedores",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev:api\" \"npm run dev -w apps/web\"",
    "dev:api": "tsx watch --env-file=.env api/_lib/devServer.ts",
    "build": "npm run build -w apps/web",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.10",
    "concurrently": "^10.0.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.2"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2"
  }
}
